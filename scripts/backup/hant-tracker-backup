#!/bin/bash
#
# Nightly database backup, run by hant-tracker-backup.timer as root. Dumps the
# database with pg_dump, checks the gzip is whole, and keeps the newest
# $KEEP nightly dumps. The pre-deploy dumps scripts/deploy.sh makes sit next
# to them and are pruned by it, not here.
#
# Installed to /usr/local/sbin by scripts/install-backups.sh.

set -euo pipefail

DATABASE="${DATABASE:-hant_tracker}"
BACKUPS="${BACKUPS:-/var/backups}"
KEEP="${KEEP:-14}"

backup="$BACKUPS/hant-tracker-$(date +%Y%m%d-%H%M%S)-nightly.sql.gz"
partial="$backup.partial"
trap 'rm -f "$partial"' EXIT

umask 077
runuser -u postgres -- pg_dump "$DATABASE" | gzip > "$partial"
# A dump cut short (disk full, pg_dump failing midway) must not replace a good one.
gzip -t "$partial"
mv "$partial" "$backup"
echo "Backed up $DATABASE to $backup ($(du -h "$backup" | cut -f1))"

find "$BACKUPS" -maxdepth 1 -name 'hant-tracker-*-nightly.sql.gz' -printf '%T@ %p\n' \
    | sort -rn | tail -n +$((KEEP + 1)) | cut -d' ' -f2- | xargs -r rm -f
