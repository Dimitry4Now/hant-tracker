# Environment for the API in production (dev needs none of this).
#
# On a server this file lives at /opt/hant-tracker/server/hant-tracker.env,
# owned by the service user and chmod 600 — it holds credentials.
# See DEPLOYMENT.md for the full walkthrough.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL. The database and role must exist before the first start.
DB_URL=jdbc:postgresql://localhost:5432/hant_tracker
DB_USER=hant_tracker
DB_PASSWORD=a-strong-password

# Signing key for the JWTs the API issues. Generate one with:
#   openssl rand -base64 48
# Anyone holding this can mint tokens for any account, so never reuse the
# development default and never commit the real value.
JWT_SECRET=replace-me-with-the-openssl-output

# Where the rolling log files go.
LOG_DIR=/opt/hant-tracker/server/logs

# Password given to a player an admin adds by hand, until they set their own.
DEFAULT_PASSWORD=change-me-on-first-login

# Used once, on an empty database, to create the first ADMIN. Remove these
# three lines after that account exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=a-strong-password
ADMIN_NAME=Your Name

# Only when the frontend is served from a different origin than the API.
# Leave unset when nginx serves both under one domain.
#CORS_ORIGINS=https://hant.example.com
